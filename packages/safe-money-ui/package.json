{
  "name": "@satjeet2005/safe-money-ui",
  "version": "0.1.0",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Satjeet2005/safe-money-ui.git"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsup",
    "prepublishOnly": "pnpm build && pnpm size"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/money/index.d.ts",
      "import": "./dist/money/index.js",
      "require": "./dist/money/index.cjs"
    },
    "./money": {
      "types": "./dist/money/index.d.ts",
      "import": "./dist/money/index.js",
      "require": "./dist/money/index.cjs"
    },
    "./submit": {
      "types": "./dist/submit/index.d.ts",
      "import": "./dist/submit/index.js",
      "require": "./dist/submit/index.cjs"
    },
    "./boundary": {
      "types": "./dist/boundary/index.d.ts",
      "import": "./dist/boundary/index.js",
      "require": "./dist/boundary/index.cjs"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "require": "./dist/react/index.cjs"
    },
    "./styles.css": "./src/react/styles.css"
  },
  "peerDependencies": {
    "react": "^18.3.0",
    "zod": "^3.23.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "react": "^18.3.1",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "zod": "^3.23.8"
  }
}
