{
  "name": "@satjeet2005/safe-money-ui",
  "version": "0.1.0",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Satjeet2005/safe-money-ui.git"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:property": "FC_NUM_RUNS=1000 jest test/property",
    "test:a11y": "jest -t A11Y-",
    "mutation": "FC_NUM_RUNS=50 stryker run",
    "build": "tsup",
    "size": "node ../../scripts/size.mjs",
    "prepublishOnly": "pnpm build && pnpm size"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/money/index.d.ts",
      "import": "./dist/money/index.mjs",
      "require": "./dist/money/index.js"
    },
    "./money": {
      "types": "./dist/money/index.d.ts",
      "import": "./dist/money/index.mjs",
      "require": "./dist/money/index.js"
    },
    "./submit": {
      "types": "./dist/submit/index.d.ts",
      "import": "./dist/submit/index.mjs",
      "require": "./dist/submit/index.js"
    },
    "./boundary": {
      "types": "./dist/boundary/index.d.ts",
      "import": "./dist/boundary/index.mjs",
      "require": "./dist/boundary/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.mjs",
      "require": "./dist/react/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "peerDependencies": {
    "react": "^18.3.0",
    "zod": "^3.23.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@stryker-mutator/core": "^8.7.1",
    "@stryker-mutator/jest-runner": "^8.7.1",
    "@stryker-mutator/typescript-checker": "^8.7.1",
    "@types/jest": "^29.5.14",
    "@types/react": "^18.3.12",
    "react": "^18.3.1",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "zod": "^3.23.8"
  }
}
