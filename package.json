{
  "name": "safe-money-ui-root",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "verify": "pnpm format:check && pnpm typecheck && pnpm lint && pnpm test && pnpm test:a11y && pnpm build && pnpm size && pnpm claims:check",
    "typecheck": "tsc --noEmit --project packages/safe-money-ui/tsconfig.json && tsc --noEmit --project apps/transfer-demo/tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "pnpm -r test",
    "test:property": "pnpm --filter @satjeet2005/safe-money-ui test:property",
    "test:a11y": "pnpm --filter @satjeet2005/safe-money-ui test:a11y && pnpm --filter transfer-demo test:a11y",
    "build": "pnpm --filter @satjeet2005/safe-money-ui build && pnpm --filter transfer-demo build",
    "size": "node scripts/size.mjs",
    "e2e": "pnpm build && node scripts/run-e2e.mjs",
    "e2e:a11y": "pnpm build && node scripts/run-e2e.mjs --spec \"cypress/e2e/j1-happy-path.cy.ts,cypress/e2e/j2-invalid-input.cy.ts,cypress/e2e/j4-timeout-recover.cy.ts,cypress/e2e/j6-rejections.cy.ts,cypress/e2e/j8-bad-payloads.cy.ts\"",
    "mutation": "echo \"mutation will be implemented in WP-26\"",
    "claims:check": "node scripts/claims-check.mjs",
    "dev": "pnpm --filter transfer-demo dev"
  },
  "devDependencies": {
    "@swc/core": "^1.10.1",
    "@swc/jest": "^0.2.37",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest": "^29.5.14",
    "@types/jest-axe": "^3.5.9",
    "axe-core": "^4.10.2",
    "cypress": "^13",
    "eslint": "^9.14.0",
    "eslint-plugin-cypress": "^5.0.0",
    "eslint-plugin-jest": "^28.9.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "fast-check": "^3.23.2",
    "globals": "^15.12.0",
    "jest": "^29.7.0",
    "jest-axe": "^9.0.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.3.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.14.0"
  }
}
